# REQUIRED. Signs login tokens. Generate with:  openssl rand -base64 48
# The server refuses to start when this is unset, shorter than 32 characters,
# or a well-known placeholder.
JWT_SECRET=

# Needed once, to create the first (admin) account on the /setup screen.
# Generate with:  openssl rand -base64 24   — remove it after setup if you like.
BOOTSTRAP_TOKEN=

# Host port for the web UI (bound to 127.0.0.1 only).
MENU_PORT=3010

# Where the SQLite database lives on the host, and who owns it (use `id -u` / `id -g`).
DATA_PATH=./data
APP_UID=1000
APP_GID=1000

# Only for `docker compose --profile tunnel up`.
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Install connector.
CLOUDFLARE_TUNNEL_TOKEN=
