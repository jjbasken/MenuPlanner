{
  "name": "menuplanner-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun --filter backend dev",
    "dev:frontend": "bun --filter frontend dev",
    "test": "bun --filter @menu/shared test && bun --filter backend test",
    "typecheck": "bun --filter '*' typecheck",
    "build": "bun --filter frontend build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11"
  }
}
