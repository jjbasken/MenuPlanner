{
  "name": "menuplanner-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun --filter backend dev",
    "dev:frontend": "bun --filter frontend dev",
    "test": "bun --filter @menu/shared test && bun --filter backend test && bun test scripts",
    "typecheck": "bun --filter '*' typecheck && tsc --noEmit -p scripts",
    "build": "bun --filter frontend build",
    "seed:demo": "bun --filter backend seed:demo",
    "mp": "bun scripts/mp.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@menu/shared": "workspace:*",
    "zod": "^3.23.0",
    "typescript": "^5.5.0"
  }
}
